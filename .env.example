# Copia este archivo a .env en la raíz del proyecto y ajusta los valores.

# ---- Backend ----
DATABASE_URL=sqlite:///./storage/app.db
STORAGE_ROOT=./storage
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Transcripcion (faster-whisper) ----
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=

# ---- Proveedor de IA para analisis semantico ----
# rule_based (100% local, sin API keys) | openai | anthropic | gemini | ollama
AI_PROVIDER=rule_based
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Limites e importacion ----
MAX_UPLOAD_SIZE_MB=20000
ALLOWED_IMPORT_ROOTS=

# ---- Rendimiento ----
MAX_PARALLEL_JOBS=1
FFMPEG_THREADS=0
